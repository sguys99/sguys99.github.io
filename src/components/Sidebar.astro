---
// Profile sidebar (DESIGN.md 5.1): record table on desktop, compact profile under the mobile bar (≤860px).
import { getEntry } from 'astro:content';
import { Picture } from 'astro:assets';
import photo from '../assets/profile.jpg';
import Icon from './Icon.astro';
import { t, type Lang } from '../i18n/ui';
import { CV_PDF } from '../cv-pdf.mjs';

interface Props {
  lang: Lang;
  /** 404 lowers the name to a paragraph: its card title is the page's h1 (DESIGN.md 6.5, 9장). */
  nameTag?: 'h1' | 'p';
}

const { lang, nameTag: Name = 'h1' } = Astro.props;
const profile = (await getEntry('profile', 'profile'))!.data;
const { email, github, linkedin } = profile.contact;
// Short addresses shown in the record (computed from the URLs, DESIGN.md 5.1).
const ghShort = github.replace(/^https?:\/\/(www\.)?/, '').replace(/\/$/, '');
const inShort = linkedin.replace(/^https?:\/\/(www\.)?linkedin\.com\//, '').replace(/\/$/, '');
---

<aside class="sidebar" aria-label={t(lang, 'profile')}>
  {/* 132px desktop / 64px mobile at 1x–3x (tasks 6.15). First-screen image, so eager + high priority. */}
  <Picture
    class="photo"
    src={photo}
    alt=""
    width={132}
    height={165}
    widths={[64, 128, 132, 192, 264, 396]}
    sizes="(max-width: 860px) 64px, 132px"
    formats={['avif', 'webp']}
    loading="eager"
    fetchpriority="high"
  />
  <div>
    <Name class="name">{profile.name[lang]}</Name>
    <p class="headline">{profile.headline[lang]}</p>
  </div>
  <ul class="contact" id="side-contact">
    <li class="em">
      <span class="k" aria-hidden="true">
        {t(lang, 'email')}
      </span>
      <a class="v" href={`mailto:${email}`}>
        <Icon name="mail" />
        <span class="lbl">{email}</span>
      </a>
    </li>
    <li>
      <span class="k" aria-hidden="true">
        GitHub
      </span>
      <a class="v" href={github} rel="noopener" aria-label={`GitHub: ${ghShort}`}>
        <Icon name="gh" />
        <span class="lbl">GitHub</span>
        <span class="h">{ghShort}</span>
      </a>
    </li>
    <li>
      <span class="k" aria-hidden="true">
        LinkedIn
      </span>
      <a class="v" href={linkedin} rel="noopener" aria-label={`LinkedIn: ${inShort}`}>
        <Icon name="in" />
        <span class="lbl">LinkedIn</span>
        <span class="h">{inShort}</span>
      </a>
    </li>
    {/* PDF is written into dist/ by scripts/cv-pdf.mjs (tasks 6.12). Desktop only; mobile has it in the menu sheet (11.8). */}
    <li class="cv">
      <span class="k" aria-hidden="true">
        {t(lang, 'cvKey')}
      </span>
      <a class="v" href={CV_PDF[lang]} download aria-label={t(lang, 'cvPdfName')}>
        {t(lang, 'cvPdf')}
        <Icon name="download" size="sm" />
      </a>
    </li>
  </ul>
</aside>

<style>
  .sidebar {
    position: sticky;
    top: 0;
    height: 100vh;
    height: 100dvh;
    overflow-y: auto;
    padding: var(--sp-7) var(--sp-6);
    display: flex;
    flex-direction: column;
    gap: var(--sp-5);
    border-right: 1px solid var(--line);
  }

  .photo {
    display: block;
    width: var(--sb-photo-w);
    aspect-ratio: 4 / 5;
    object-fit: cover;
    border-radius: var(--radius-sm);
    border: 1px solid var(--photo-ring);
    background: var(--chip);
    filter: var(--photo-filter);
  }

  .name {
    font-family: var(--font-display);
    font-size: var(--fs-xl);
    font-weight: var(--fw-name);
    letter-spacing: var(--ls-name);
    line-height: 1.25;
  }

  .headline {
    margin-top: var(--sp-1);
    color: var(--accent);
    font-weight: var(--fw-medium);
  }

  /* Record table */
  .contact {
    list-style: none;
    border-top: 1px solid var(--line-strong);
  }

  .contact li {
    display: grid;
    grid-template-columns: var(--sb-key) minmax(0, 1fr);
    align-items: baseline;
    gap: var(--sp-3);
    padding: var(--sp-3) 0;
    border-bottom: 1px solid var(--line);
  }

  .k {
    font-size: var(--fs-2xs);
    font-weight: var(--fw-strong);
    letter-spacing: var(--ls-label);
    text-transform: uppercase;
    color: var(--text-3);
  }

  html:lang(ko) .k {
    font-size: var(--fs-xs);
    letter-spacing: var(--ls-label-ko);
    text-transform: none;
  }

  .v {
    min-width: 0;
    font-size: var(--fs-sm);
    line-height: var(--lh-row);
    color: var(--text);
  }

  a.v {
    overflow-wrap: anywhere;
    text-decoration: underline;
    text-decoration-color: var(--line-strong);
    text-underline-offset: var(--underline-offset);
    transition:
      color var(--dur) ease,
      text-decoration-color var(--dur) ease;
  }

  a.v:hover {
    color: var(--accent);
    text-decoration-color: var(--accent);
  }

  /* Desktop shows short addresses only: icons and link names are for the mobile row. */
  .contact li:not(.cv) :global(.icon),
  li:not(.em) .lbl {
    display: none;
  }

  .cv a.v {
    display: inline-flex;
    align-items: center;
    gap: var(--sp-1);
  }

  .h {
    display: block;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  /* Mobile: compact profile below the bar (DESIGN.md 4장 모바일 골격, 5.1 반응형) */
  @media (max-width: 860px), print {
    .sidebar {
      position: static;
      height: auto;
      overflow: visible;
      border-right: 0;
      border-bottom: 1px solid var(--line);
      padding: var(--sp-4);
      display: grid;
      grid-template-columns: var(--sb-photo-w-sm) minmax(0, 1fr);
      align-items: center;
      gap: var(--sp-2) var(--sp-4);
    }

    .photo {
      width: var(--sb-photo-w-sm);
      border-radius: var(--radius);
    }

    .name {
      font-size: var(--fs-lg);
    }

    .headline {
      margin-top: 0;
      font-size: var(--fs-sm);
    }

    .contact {
      grid-column: 1 / -1;
      display: flex;
      flex-wrap: wrap;
      gap: var(--sp-2) var(--sp-4);
      padding-top: var(--sp-3);
      border-top-color: var(--line);
    }

    .contact li {
      display: block;
      padding: 0;
      border: 0;
      min-width: 0;
      max-width: 100%;
    }

    .contact .cv,
    .k,
    .h {
      display: none;
    }

    .contact li:not(.cv) :global(.icon),
    li:not(.em) .lbl {
      display: block;
    }

    a.v {
      display: flex;
      align-items: center;
      gap: var(--sp-2);
      color: var(--text-2);
      text-decoration: none;
      overflow-wrap: normal;
    }

    .lbl {
      min-width: 0;
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
    }
  }
</style>
