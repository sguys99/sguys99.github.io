---
// Contact (DESIGN.md 5.23, 3.2.8 A): open-to list | email + copy + links. No phone number.
import Card from './Card.astro';
import SectionHead from './SectionHead.astro';
import CopyButton from './CopyButton.astro';
import Icon from './Icon.astro';
import { t, type Lang } from '../i18n/ui';
import { getEntry } from 'astro:content';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const { contact, availability } = (await getEntry('profile', 'profile'))!.data;
---

<Card id="contact" labelledby="h-contact">
  <SectionHead id="contact" title={t(lang, 'contact')} />
  <div class="ct">
    <div>
      <h3 class="eyebrow">{t(lang, 'openTo')}</h3>
      <ul class="avail">
        {availability.map((a) => (
          <li>{a[lang]}</li>
        ))}
      </ul>
    </div>
    <div>
      <h3 class="eyebrow">{t(lang, 'reachMe')}</h3>
      <div class="reach">
        <div class="mail-row">
          <a class="mail" href={`mailto:${contact.email}`}>
            {contact.email}
          </a>
          <CopyButton lang={lang} email={contact.email} />
        </div>
        <ul class="links">
          <li>
            <a href={contact.github} rel="noopener">
              <Icon name="gh" />
              GitHub
            </a>
          </li>
          <li>
            <a href={contact.linkedin} rel="noopener">
              <Icon name="in" />
              LinkedIn
            </a>
          </li>
        </ul>
      </div>
    </div>
  </div>
</Card>

<style>
  .ct {
    display: grid;
    grid-template-columns: minmax(0, 1.35fr) minmax(0, 1fr);
    gap: var(--sp-7);
  }

  .eyebrow {
    margin: 0 0 var(--sp-3);
    font-family: var(--font-meta);
    font-size: var(--fs-xs);
    font-weight: var(--fw-medium);
    letter-spacing: var(--ls-eyebrow);
    text-transform: uppercase;
    color: var(--text-3);
  }

  :global(html:lang(ko)) .eyebrow {
    font-family: var(--font-ko);
    font-size: var(--fs-sm);
    font-weight: var(--fw-strong);
    letter-spacing: var(--ls-eyebrow-ko);
  }

  ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .avail {
    counter-reset: av;
    border-top: 1px solid var(--line);
  }

  .avail li {
    counter-increment: av;
    display: grid;
    grid-template-columns: var(--col-idx-sm) minmax(0, 1fr);
    gap: var(--sp-2);
    padding: var(--sp-3) 0;
    border-bottom: 1px solid var(--line);
    font-size: var(--fs-sm);
    color: var(--text);
  }

  .avail li::before {
    content: counter(av, decimal-leading-zero);
    padding-top: var(--sp-0);
    font-family: var(--font-meta);
    font-size: var(--fs-xs);
    font-variant-numeric: tabular-nums;
    color: var(--text-3);
  }

  .reach {
    display: grid;
    align-content: start;
    gap: var(--sp-4);
    padding-top: var(--sp-4);
    border-top: 1px solid var(--line);
  }

  .mail-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--sp-2) var(--sp-3);
  }

  .mail {
    font-size: var(--fs-lg);
    font-weight: var(--fw-medium);
    color: var(--accent);
    text-decoration: underline;
    text-decoration-color: var(--line-strong);
    text-underline-offset: var(--underline-offset);
    overflow-wrap: anywhere;
    transition: text-decoration-color var(--dur) ease;
  }

  .mail:hover {
    text-decoration-color: var(--accent);
  }

  .links {
    display: flex;
    flex-direction: column;
    align-items: start;
    gap: var(--sp-2);
  }

  .links a {
    display: inline-flex;
    align-items: center;
    gap: var(--sp-2);
    font-size: var(--fs-sm);
    color: var(--text-2);
    text-decoration: none;
    transition: color var(--dur) ease;
  }

  .links a:hover {
    color: var(--accent);
  }

  @media (max-width: 860px) {
    .ct {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--sp-6);
    }
  }
</style>
