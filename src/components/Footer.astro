---
// Colophon footer (DESIGN.md 5.5): ©, last-updated date, site source, back to top. Sits right after <main> (contentinfo).
import { execFileSync } from 'node:child_process';
import { getEntry } from 'astro:content';
import { t, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const profile = (await getEntry('profile', 'profile'))!.data;
const REPO = 'https://github.com/sguys99/sguys99.github.io';

/** Date of the last commit touching src/content (YYYY-MM-DD), or undefined without git or its history. Also sitemap `lastmod`. */
export function contentDate(): string | undefined {
  try {
    const out = execFileSync('git', ['log', '-1', '--format=%cs', '--', 'src/content'], {
      encoding: 'utf8',
      stdio: ['ignore', 'pipe', 'ignore'],
    }).trim();
    if (/^\d{4}-\d{2}-\d{2}$/.test(out)) return out;
  } catch {}
}

// Build date when git is unavailable.
const iso = contentDate() ?? new Date().toISOString().slice(0, 10);
const [y, m, d] = iso.split('-');
// en `Nov 10, 2026`, ko `2026.11.10` (DESIGN.md 5.5, 7장).
const shown =
  lang === 'ko'
    ? `${y}.${m}.${d}`
    : new Date(`${iso}T00:00:00Z`).toLocaleDateString('en-US', {
        month: 'short',
        day: 'numeric',
        year: 'numeric',
        timeZone: 'UTC',
      });
---

<footer class="foot">
  <p>
    © <span class="num">{y}</span> {profile.name[lang]}
  </p>
  <ul>
    <li>
      {t(lang, 'lastUpdated')}{' '}
      <time class="num" datetime={iso}>
        {shown}
      </time>
    </li>
    <li>
      <a href={REPO} rel="noopener">
        {t(lang, 'siteSource')}
      </a>
    </li>
    <li>
      <a href="#main">
        {t(lang, 'backToTop')} <span aria-hidden="true">↑</span>
      </a>
    </li>
  </ul>
</footer>

<style>
  .foot {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--sp-2) var(--sp-5);
    /* Inset like main's content so the hairline spans the card width, not the column. */
    margin: 0 var(--sp-7);
    padding: var(--sp-4) var(--sp-1) var(--sp-8);
    border-top: 1px solid var(--line);
    font-family: var(--font-meta);
    font-size: var(--fs-xs);
    color: var(--text-3);
  }

  .foot p {
    margin: 0;
  }

  .foot ul {
    display: flex;
    flex-wrap: wrap;
    gap: var(--sp-2) var(--sp-5);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .foot a {
    color: var(--text-2);
    text-decoration-color: var(--line-strong);
    transition:
      color var(--dur) ease,
      text-decoration-color var(--dur) ease;
  }

  .foot a:hover {
    color: var(--accent);
    text-decoration-color: var(--accent);
  }

  @media (max-width: 1100px) {
    .foot {
      margin: 0 var(--sp-6);
    }
  }

  @media (max-width: 860px) {
    .foot {
      margin: 0 var(--sp-4);
    }
  }

  @media (max-width: 560px) {
    .foot {
      flex-direction: column;
    }
  }
</style>
