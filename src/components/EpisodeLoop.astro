---
// Episode anatomy and training loop (DESIGN.md 5.24.10; g14 시안 C): one demonstration as five recorded tracks
// over labeled segments, then the four-step loop that consumes it, with the accent return path for runs below target.
// Data: diagrams/<slug>.yaml `episode`. The SVG is hidden from screen readers; the same content is in .sr-only text.
import type { CollectionEntry } from 'astro:content';
import { t, type Lang } from '../i18n/ui';

type Episode = NonNullable<CollectionEntry<'diagrams'>['data']['episode']>;

interface Props {
  lang: Lang;
  data: Episode;
  label: string; // accessible name, the section title
}

const { lang, data, label } = Astro.props;
const { segments, tracks, instruction, result, steps, back, metrics, note } = data;

// SVG units: track names 0–104, the timeline X0–X1, segment labels on top, tracks 36 apart from y 32,
// a rule at 232, then the loop row at LY with the return path under it.
const W = 720;
const X0 = 120;
const X1 = 680;
const SEG = (X1 - X0) / segments.length;
const ty = (k: number) => 32 + k * 36;
const LY = 252;
const SX = [0, 188, 376, 564];
const BW = 140;
const H = LY + 108;
const id = `ep-${lang}`;
// Same 8px mono face and .el tracking as the edge labels in Diagram.astro.
const lw = (s: string) => [...s].reduce((n, c) => n + (/\p{Script=Hangul}/u.test(c) ? 8 : 5.6), 0);
const bw = lw(back[lang]) + 16;
// Illustrative traces: smooth deterministic shapes, not recorded data.
let state = `M${X0},${ty(2) + 12}`;
for (let x = X0; x <= X1; x += 8)
  state += ` L${x},${(ty(2) + 12 - 9 * Math.sin((x - X0) / 34) * Math.cos((x - X0) / 97)).toFixed(1)}`;
const actions = Array.from({ length: 35 }, (_, i) =>
  (0.25 + 0.6 * Math.abs(Math.sin(i * 0.7))).toFixed(2),
);
---

<figure class="ep">
  <div class="ep-scroll" tabindex="0" role="region" aria-label={label}>
    <svg viewBox={`0 0 ${W} ${H}`} aria-hidden="true" focusable="false">
      <defs>
        <marker id={id} markerWidth="8" markerHeight="6" refX="7" refY="3" orient="auto">
          <polygon class="mk" points="0 0, 8 3, 0 6"></polygon>
        </marker>
        <marker id={`${id}a`} markerWidth="8" markerHeight="6" refX="7" refY="3" orient="auto">
          <polygon class="mk acc" points="0 0, 8 3, 0 6"></polygon>
        </marker>
      </defs>
      {segments.map((s, i) => (
        <>
          <text class="ns" x={X0 + SEG * (i + 0.5)} y="16" text-anchor="middle">
            {s[lang]}
          </text>
          {i > 0 && <path class="sep" d={`M${X0 + SEG * i},24 V212`} />}
        </>
      ))}
      {tracks.map((tr, k) => (
        <>
          <text class="nt" x="0" y={ty(k) + 16}>
            {tr.name[lang]}
          </text>
          <text class="ns" x="104" y={ty(k) + 16} text-anchor="end">
            {tr.key}
          </text>
        </>
      ))}
      <rect class="bar" x={X0} y={ty(0)} width={X1 - X0} height="24" rx="4" />
      <text class="tx" x={X0 + 12} y={ty(0) + 16}>
        {instruction[lang]}
      </text>
      {Array.from({ length: 14 }, (_, i) => (
        <rect class="frame" x={X0 + i * 40} y={ty(1)} width="36" height="24" rx="2" />
      ))}
      <path class="wave" d={state} />
      {actions.map((o, i) => (
        <rect
          class="cell"
          x={X0 + i * 16}
          y={ty(3) + 4}
          width="12"
          height="16"
          rx="1"
          opacity={o}
        />
      ))}
      <path class="rule" d={`M${X0},${ty(4) + 12} H${X1 - 72}`} />
      <rect class="res" x={X1 - 64} y={ty(4)} width="96" height="24" rx="12" />
      <text class="rt" x={X1 - 16} y={ty(4) + 16} text-anchor="middle">
        {result[lang]}
      </text>
      <path class="rule" d={`M0,232 H${W}`} />
      {steps.map((s, i) => (
        <>
          {i < steps.length - 1 && (
            <path
              class="ln"
              d={`M${SX[i] + BW},${LY + 28} H${SX[i + 1]}`}
              marker-end={`url(#${id})`}
            />
          )}
          <rect
            class:list={['box', { focus: s.focus }]}
            x={SX[i]}
            y={LY}
            width={BW}
            height="56"
            rx="6"
          />
          <text class="nt" x={SX[i] + BW / 2} y={LY + 24} text-anchor="middle">
            {s.name[lang]}
          </text>
          <text class="ns" x={SX[i] + BW / 2} y={LY + 40} text-anchor="middle">
            {s.sub[lang]}
          </text>
        </>
      ))}
      <path
        class="ln acc"
        d={`M634,${LY + 56} V${LY + 84} Q634,${LY + 92} 626,${LY + 92} H78 Q70,${LY + 92} 70,${LY + 84} V${LY + 56}`}
        marker-end={`url(#${id}a)`}
      />
      <rect class="em" x={W / 2 - bw / 2} y={LY + 72} width={bw} height="12" rx="2" />
      <text class="el" x={W / 2} y={LY + 81} text-anchor="middle">
        {back[lang]}
      </text>
    </svg>
  </div>
  <p class="hint">{t(lang, 'dgScroll')}</p>
  <div class="sr-only">
    <p>
      {instruction[lang]}: {segments.map((s) => s[lang]).join(' → ')}. {result[lang]}
    </p>
    <p>{tracks.map((tr) => tr.name[lang]).join(', ')}</p>
    <ol>
      {steps.map((s) => (
        <li>
          {s.name[lang]}, {s.sub[lang]}
        </li>
      ))}
    </ol>
    <p>{back[lang]}</p>
  </div>
  <p class="note">{note[lang]}</p>
  <p class="note">{metrics[lang]}</p>
</figure>

<style>
  .ep {
    container-type: inline-size;
  }

  /* Same narrow-column rule as the diagrams (5.24.4): keep 12px text, scroll inside the figure. */
  .ep-scroll {
    overflow-x: auto;
  }

  .ep-scroll:focus-visible {
    outline: var(--focus-w) solid var(--focus);
    outline-offset: var(--focus-offset);
    border-radius: var(--radius-xs);
  }

  svg {
    display: block;
    width: 100%;
    min-width: 640px;
    height: auto;
    font-family: inherit;
  }

  .hint {
    display: none;
    margin-top: var(--sp-2);
    font-size: var(--fs-xs);
    color: var(--text-3);
  }

  @container (max-width: 639px) {
    .hint {
      display: block;
    }
  }

  .nt {
    fill: var(--text);
    font-size: 12px;
    font-weight: var(--fw-strong);
  }

  .tx {
    fill: var(--text-2);
    font-size: 12px;
  }

  .ns {
    fill: var(--text-3);
    font-family: var(--font-meta);
    font-size: 9px;
  }

  .sep {
    stroke: var(--text-3);
    stroke-dasharray: 2 3;
  }

  .bar {
    fill: var(--surface);
    stroke: var(--line-strong);
    stroke-width: 0.8;
  }

  .frame {
    fill: var(--chip);
    stroke: var(--line-strong);
    stroke-width: 0.8;
  }

  .wave {
    fill: none;
    stroke: var(--text-2);
    stroke-width: 1.4;
  }

  .cell {
    fill: var(--accent);
  }

  .rule {
    stroke: var(--line);
  }

  .res {
    fill: var(--accent-soft);
    stroke: var(--accent);
  }

  .rt {
    fill: var(--accent);
    font-size: 12px;
    font-weight: var(--fw-strong);
  }

  .box {
    fill: var(--surface);
    stroke: var(--line-strong);
  }

  .box.focus {
    fill: var(--accent-soft);
    stroke: var(--accent);
  }

  .ln {
    fill: none;
    stroke: var(--text-3);
    stroke-width: 1.2;
  }

  .ln.acc {
    stroke: var(--accent);
    stroke-width: 1.6;
  }

  .mk {
    fill: var(--text-3);
  }

  .mk.acc {
    fill: var(--accent);
  }

  .em {
    fill: var(--surface);
  }

  .el {
    fill: var(--accent);
    font-family: var(--font-meta);
    font-size: 8px;
    letter-spacing: 0.06em;
  }

  .note {
    margin-top: var(--sp-3);
    max-width: var(--measure);
    font-size: var(--fs-sm);
    color: var(--text-2);
  }

  .note + .note {
    margin-top: var(--sp-1);
  }
</style>
