---
// IP & Publications (DESIGN.md 5.21, 3.2.5 B): one drawer per record type, opening to a year-grouped list.
// Native <details> (5.9 A): works without JS, starts closed. Patent and registration numbers are never shown (tasks 1.1.4).
import Card from './Card.astro';
import SectionHead from './SectionHead.astro';
import Disclosure from './Disclosure.astro';
import Status from './Status.astro';
import Badge from './Badge.astro';
import { t, fmtYears, type Lang } from '../i18n/ui';
import { getCollection } from 'astro:content';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;

type Item = {
  id: string;
  year: string; // '' = no date (pending registration)
  sort: string;
  title: { en: string; ko: string };
  status?: 'registered' | 'filed' | 'filing' | 'pending';
  authors?: string;
  venue?: string;
  doi?: string;
  publisher?: string;
  featured?: boolean;
};

// Newest first; undated (pending) entries on top (5.21).
const desc = (xs: Item[]) =>
  xs.sort((a, b) => (b.sort || '9999').localeCompare(a.sort || '9999') || a.id.localeCompare(b.id));

const patents = desc(
  (await getCollection('patents')).map(({ id, data: p }) => ({
    id,
    year: p.date.slice(0, 4),
    sort: p.date,
    title: p.title,
    status: p.status === 'registered' ? 'registered' : p.number ? 'filed' : 'filing',
  })),
);
const software = desc(
  (await getCollection('software')).map(({ id, data: s }) => ({
    id,
    year: s.date?.slice(0, 4) ?? '',
    sort: s.date ?? '',
    title: s.title,
    status: s.status,
  })),
);
const pubs = await getCollection('publications');
const papers = desc(
  pubs.flatMap(({ id, data: p }) =>
    p.type === 'paper'
      ? [
          {
            id,
            year: String(p.year),
            sort: String(p.year),
            title: p.title,
            authors: p.authors,
            venue: p.venue[lang],
            doi: p.doi,
          },
        ]
      : [],
  ),
);
const reports = desc(
  pubs.flatMap(({ id, data: p }) =>
    p.type === 'report'
      ? [
          {
            id,
            year: String(p.year),
            sort: String(p.year),
            title: p.title,
            publisher: p.publisher?.[lang],
            featured: p.featured,
          },
        ]
      : [],
  ),
);

const count = (xs: Item[], s: Item['status']) => xs.filter((x) => x.status === s).length;
const span = (xs: Item[]) => {
  const ys = xs
    .map((x) => x.year)
    .filter(Boolean)
    .sort();
  return fmtYears(lang, { start: ys[0], end: ys.at(-1) });
};

const drawers = [
  {
    key: 'pat',
    name: t(lang, 'patents'),
    items: patents,
    breakdown: t(lang, 'regFiled', {
      reg: count(patents, 'registered'),
      filed: patents.length - count(patents, 'registered'),
    }),
  },
  {
    key: 'sw',
    name: t(lang, 'software'),
    items: software,
    breakdown: t(lang, 'regPending', {
      reg: count(software, 'registered'),
      pending: count(software, 'pending'),
    }),
  },
  { key: 'paper', name: t(lang, 'papers'), items: papers, breakdown: t(lang, 'withDoi') },
  {
    key: 'report',
    name: t(lang, 'reports'),
    items: reports,
    breakdown: t(lang, 'selectedCount', { n: reports.filter((r) => r.featured).length }),
  },
];
const total = drawers.reduce((n, d) => n + d.items.length, 0);

const byYear = (xs: Item[]) =>
  xs.reduce<{ year: string; xs: Item[] }[]>((g, x) => {
    const last = g.at(-1);
    if (last && last.year === x.year) last.xs.push(x);
    else g.push({ year: x.year, xs: [x] });
    return g;
  }, []);

// Bold the owner's name in an author line: "K. M. Yu", "K. Yu", "K.-M. Yu".
const authorParts = (s: string) => s.split(/(K\.(?:[ -]M\.)? Yu)/);
---

<Card id="ip" labelledby="h-ip">
  <SectionHead id="ip" title={t(lang, 'ip')}>
    {t(lang, 'recordCount', { n: total })}
  </SectionHead>

  <div class="drawers">
    {drawers.map((d) => (
      <Disclosure id={`ip-${d.key}`}>
        <Fragment slot="summary">
          <span class="dn">{d.name}</span>
          <span class="dc num">{d.items.length}</span>
          <span class="db">{d.breakdown}</span>
          <span class="dy num">{span(d.items)}</span>
        </Fragment>
        <div class="dbody">
          <ol class="yg">
            {byYear(d.items).map((g) => (
              <li>
                <h3 class:list={['yh', { word: !g.year }]}>{g.year || t(lang, 'pending')}</h3>
                <ol class="ip-list">
                  {g.xs.map((x) => (
                    <li class="it">
                      <span class="tt">
                        {x.title[lang]}
                        {x.featured && [' ', <Badge lang={lang} kind="selected" />]}
                      </span>
                      {lang === 'en' && x.title.ko !== x.title.en && (
                        <span class="og" lang="ko">
                          {x.title.ko}
                        </span>
                      )}
                      {x.authors && (
                        <p class="au">
                          {authorParts(x.authors).map((s, i) => (i % 2 ? <b>{s}</b> : s))}
                        </p>
                      )}
                      {(x.status || x.venue || x.publisher || x.doi) && (
                        <p class="mt">
                          {x.status && <Status lang={lang} value={x.status} />}
                          {x.venue && <span>{x.venue}</span>}
                          {x.publisher && <span>{x.publisher}</span>}
                          {x.doi && (
                            <a href={`https://doi.org/${x.doi}`} rel="noopener">
                              DOI {x.doi}
                            </a>
                          )}
                        </p>
                      )}
                    </li>
                  ))}
                </ol>
              </li>
            ))}
          </ol>
        </div>
      </Disclosure>
    ))}
  </div>
</Card>

<style>
  .drawers {
    border-top: 1px solid var(--line-strong);
  }

  .drawers :global(.dr) {
    border-bottom: 1px solid var(--line);
  }

  .drawers :global(summary) {
    display: grid;
    grid-template-columns: minmax(0, 1.4fr) 64px minmax(0, 2fr) 96px 20px;
    align-items: baseline;
    gap: var(--sp-4);
    padding: var(--sp-4) 0;
  }

  .drawers :global(.dr[open] > summary) {
    padding-bottom: var(--sp-2);
  }

  .drawers :global(summary .chev) {
    align-self: center;
  }

  .dn {
    font-size: var(--fs-lg);
    font-weight: var(--fw-strong);
    letter-spacing: -0.01em;
    color: var(--text);
  }

  .dc {
    font-family: var(--font-meta);
    font-size: var(--fs-xl);
    font-weight: var(--fw-medium);
    line-height: 1;
    text-align: right;
    color: var(--text);
  }

  .db {
    font-size: var(--fs-sm);
    color: var(--text-2);
  }

  .dy {
    font-family: var(--font-meta);
    font-size: var(--fs-xs);
    text-align: right;
    color: var(--text-3);
  }

  .dbody {
    padding-bottom: var(--sp-5);
  }

  .yg,
  .ip-list {
    list-style: none;
  }

  .yg > li {
    display: grid;
    grid-template-columns: var(--col-year) minmax(0, 1fr);
    gap: var(--sp-4);
    border-top: 1px solid var(--line);
  }

  .yh {
    padding-top: calc(var(--sp-3) + var(--sp-0));
    font-family: var(--font-meta);
    font-size: var(--fs-xs);
    font-weight: var(--fw-medium);
    color: var(--text-3);
  }

  /* A word, not a year: Hangul has no mono face (same switch as the status words, 11.8). */
  html:lang(ko) .yh.word {
    font-family: var(--font-ko);
    text-wrap: balance;
  }

  .it {
    padding: var(--sp-3) 0;
    border-top: 1px solid var(--line);
  }

  .it:first-child {
    border-top: 0;
  }

  .tt {
    display: block;
    font-size: var(--fs-sm);
    font-weight: var(--fw-medium);
    line-height: 1.5;
    color: var(--text);
  }

  .og {
    display: block;
    margin-top: var(--sp-0);
    font-family: var(--font-ko);
    font-size: var(--fs-xs);
    line-height: 1.55;
    color: var(--text-3);
    word-break: keep-all;
  }

  .au {
    margin-top: var(--sp-1);
    font-size: var(--fs-xs);
    color: var(--text-2);
  }

  .au b {
    font-weight: var(--fw-strong);
    color: var(--text);
  }

  .mt {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--sp-1) var(--sp-3);
    margin-top: var(--sp-1);
    font-size: var(--fs-xs);
    color: var(--text-3);
  }

  .mt a {
    font-family: var(--font-meta);
    color: var(--accent);
    text-decoration: underline;
    text-decoration-color: transparent;
    text-underline-offset: var(--underline-offset);
    overflow-wrap: anywhere;
    transition: text-decoration-color var(--dur) ease;
  }

  .mt a:hover {
    text-decoration-color: currentColor;
  }

  @media (max-width: 560px) {
    .drawers :global(summary) {
      grid-template-columns: minmax(0, 1fr) auto 20px;
      grid-template-areas: 'n c v' 'b y .';
      row-gap: var(--sp-0);
    }

    .dn {
      grid-area: n;
    }

    .dc {
      grid-area: c;
    }

    .drawers :global(summary .chev) {
      grid-area: v;
    }

    .db {
      grid-area: b;
      font-size: var(--fs-xs);
    }

    .dy {
      grid-area: y;
      white-space: nowrap;
    }

    .yg > li {
      grid-template-columns: minmax(0, 1fr);
      gap: 0;
    }

    .yh {
      padding-top: var(--sp-3);
    }

    .it:first-child {
      padding-top: var(--sp-1);
    }
  }
</style>
