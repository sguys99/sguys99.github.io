---
// Inline line icons (DESIGN.md 5.12). Decorative only: meaning comes from adjacent text or the control's aria-label.
// Size defaults to --icon; `size` picks another step of the 5.12 scale (thinner stroke at sm and below).
const paths = {
  mail: '<rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3 7 9 6 9-6"/>',
  gh: '<path d="M9 19c-4 1.5-4-2-6-2.5m12 5v-3.5c0-1 .1-1.4-.5-2 2.8-.3 5.5-1.4 5.5-6a4.6 4.6 0 0 0-1.3-3.2 4.2 4.2 0 0 0-.1-3.2s-1.1-.3-3.5 1.3a12 12 0 0 0-6.2 0C6.5 2.8 5.4 3.1 5.4 3.1a4.2 4.2 0 0 0-.1 3.2A4.6 4.6 0 0 0 4 9.5c0 4.6 2.7 5.7 5.5 6-.6.6-.6 1.2-.5 2V21"/>',
  in: '<rect x="3" y="3" width="18" height="18" rx="2"/><path d="M8 10v7M8 7v.01M12 17v-4a2 2 0 0 1 4 0v4M12 10v7"/>',
  menu: '<path d="M4 8h16M4 16h16"/>',
  close: '<path d="M6 6l12 12M18 6 6 18"/>',
  moon: '<path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5Z"/>',
  sun: '<circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/>',
  arrow: '<path d="M5 12h14M13 6l6 6-6 6"/>',
  back: '<path d="M19 12H5M11 6l-6 6 6 6"/>',
  ext: '<path d="M7 17 17 7M9 7h8v8"/>',
  chev: '<path d="m6 9 6 6 6-6"/>',
  copy: '<rect x="9" y="9" width="11" height="11" rx="2"/><path d="M5 15V5a1 1 0 0 1 1-1h10"/>',
  ok: '<path d="m5 12 5 5L20 7"/>',
};

interface Props {
  name: keyof typeof paths;
  size?: 'xs' | 'sm' | 'lg';
  class?: string;
}

const { name, size, class: cls } = Astro.props;
---

<svg
  class:list={['icon', size, cls]}
  viewBox="0 0 24 24"
  aria-hidden="true"
  focusable="false"
  set:html={paths[name]}
/>

<style>
  .icon {
    width: var(--icon);
    height: var(--icon);
    flex: none;
    fill: none;
    stroke: currentColor;
    stroke-width: var(--icon-stroke);
  }

  .xs,
  .sm {
    stroke-width: var(--icon-stroke-sm);
  }

  .xs {
    width: var(--icon-xs);
    height: var(--icon-xs);
  }

  .sm {
    width: var(--icon-sm);
    height: var(--icon-sm);
  }

  .lg {
    width: var(--icon-lg);
    height: var(--icon-lg);
  }
</style>
