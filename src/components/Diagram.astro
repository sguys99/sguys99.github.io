---
// Case study diagram (DESIGN.md 5.24.4; g9 시안 A): inline SVG drawn from src/content/diagrams/<slug>.yaml.
// The SVG is hidden from screen readers; the same content is listed in .sr-only text below it.
import type { CollectionEntry } from 'astro:content';
import { t, type Lang } from '../i18n/ui';

type File = CollectionEntry<'diagrams'>['data'];
type Spec = NonNullable<File['arch']>;

interface Props {
  lang: Lang;
  spec: Spec;
  legend: File['legend']; // file default; spec.legend replaces it
  label: string; // accessible name, the section title
  uid: string; // unique per page (the slot: problem, approach, arch, flow), for the marker id
}

const { lang, spec, label, uid } = Astro.props;
const legend = spec.legend ?? Astro.props.legend;
const {
  width: W,
  height: H,
  zones,
  nodes,
  edges,
  stages,
  curve,
  dots,
  callouts,
  marks,
  route,
  rings,
  texts,
} = spec;
const arrow = `url(#dg-ar-${uid}-${lang})`;
const arrowAcc = `url(#dg-ara-${uid}-${lang})`;

// Mask width for centered zone labels and edge labels (Latin ~6.8px, Hangul 12px at 12px).
const est = (s: string) => [...s].reduce((n, c) => n + (/[ㄱ-힝]/.test(c) ? 12 : 6.8), 0);
const lines = (s: string) => s.split('\n');
// A zone drawn inside another zone gets the card surface and a hairline, so it stays visible on the outer wash.
type Box = { x: number; y: number; w: number; h: number };
const within = (a: Box, b: Box) =>
  a !== b && a.x >= b.x && a.y >= b.y && a.x + a.w <= b.x + b.w && a.y + a.h <= b.y + b.h;
const nested = new Set(zones.filter((z) => zones.some((o) => within(z, o))).map((z) => z.id));
// Edge labels (8px mono, ~4.8px per Latin glyph) always sit on a mask matching what is under them:
// the zone wash when the label is inside an outer zone, else the card surface.
const lw = (s: string) => [...s].reduce((n, c) => n + (/[ㄱ-힝]/.test(c) ? 8 : 4.8), 0);
const onWash = (p: { x: number; y: number }) => {
  const z = zones
    .filter((z) => p.x >= z.x && p.y >= z.y && p.x <= z.x + z.w && p.y <= z.y + z.h)
    .sort((a, b) => a.w * a.h - b.w * b.h)[0];
  return !!z && !nested.has(z.id);
};

// Legend strip under the drawing: hairline, then one item per kind.
const LG = H - 12;
const lgStep = W / legend.length;

// Screen-reader text: each node under its innermost zone, then the connections.
const area = (r: { w: number; h: number }) => r.w * r.h;
const kindLabel = new Map(legend.map((l) => [l.kind, l.label[lang]]));
const nodeText = (n: Spec['nodes'][number]) =>
  n.label[lang].replace(/\n/g, ' ') +
  (n.sub ? `, ${n.sub[lang]}` : '') +
  (kindLabel.has(n.kind) && n.kind !== 'logic' && n.kind !== 'plain'
    ? ` (${kindLabel.get(n.kind)})`
    : '');
const groups = new Map<string, string[]>([
  ['', []],
  ...zones.map((z) => [z.id, []] as [string, string[]]),
]);
const zoneLabel = new Map(zones.map((z) => [z.id, z.label[lang]]));
const plain = (n: { label: { en: string; ko: string } }) => n.label[lang].replace(/\n/g, ' ');
const name = new Map([...zones, ...nodes, ...dots].map((n) => [n.id, plain(n)]));
// Floor plan marks: read as "n name" in order; edges that name a mark use the same text.
const markText = (m: (typeof marks)[number]) => (m.label ? `${m.n} ${m.label[lang]}` : m.n);
for (const m of marks) name.set(m.id, markText(m));
const stopText = marks.map(markText).join(' → ');
// Touchpoint dots are listed under their lane (zone) like nodes; the curve is read as the path through them in order.
for (const d of dots) {
  const home = zones.find((z) => d.x >= z.x && d.y >= z.y && d.x <= z.x + z.w && d.y <= z.y + z.h);
  groups.get(home?.id ?? '')!.push(plain(d));
}
const pathText = curve && dots.length ? dots.map(plain).join(' → ') : '';
for (const n of nodes) {
  const home = zones.filter((z) => within(n, z)).sort((a, b) => area(a) - area(b))[0];
  groups.get(home?.id ?? '')!.push(nodeText(n));
  // Two steps with the same name (e.g. Generation in two agents): name the zone in connections.
  if (home && nodes.some((o) => o !== n && plain(o) === plain(n)))
    name.set(n.id, `${plain(n)} (${home.label[lang]})`);
}
const linkText = (e: Spec['edges'][number]) =>
  t(lang, e.style === 'both' ? 'dgWith' : e.style === 'back' ? 'dgBack' : 'dgThen', {
    a: name.get(e.from)!,
    b: name.get(e.to)!,
  });
---

<figure class="dg">
  <div class="dg-scroll" tabindex="0" role="region" aria-label={label}>
    <svg viewBox={`0 0 ${W} ${H}`} aria-hidden="true" focusable="false">
      <defs>
        <marker
          id={`dg-ar-${uid}-${lang}`}
          markerWidth="8"
          markerHeight="6"
          refX="7"
          refY="3"
          orient="auto-start-reverse"
        >
          <polygon class="mk" points="0 0, 8 3, 0 6"></polygon>
        </marker>
        {edges.some((e) => e.style === 'acc') && (
          <marker
            id={`dg-ara-${uid}-${lang}`}
            markerWidth="8"
            markerHeight="6"
            refX="7"
            refY="3"
            orient="auto-start-reverse"
          >
            <polygon class="mk acc" points="0 0, 8 3, 0 6" />
          </marker>
        )}
      </defs>
      {/* z-order: stages → zones → connectors and path → labels on connectors → callouts → nodes → dots (diagram-design §6) */}
      {stages?.items.map((s, i) => {
        const x = stages.x + stages.w * i;
        const { y, h, w } = stages;
        // Chevrons: the first has a flat left end, the rest a notch that takes the previous point.
        const notch = i ? `${x + 8},${y + h / 2} ` : '';
        return (
          <>
            <polygon
              class="stg"
              points={`${notch}${x},${y} ${x + w - 8},${y} ${x + w},${y + h / 2} ${x + w - 8},${y + h} ${x},${y + h}`}
            />
            <text class="stt" x={x + w / 2 + (i ? 2 : -2)} y={y + h / 2 + 4} text-anchor="middle">
              {s[lang]}
            </text>
          </>
        );
      })}
      {zones.map((z) => (
        <>
          <rect
            class:list={['zone', { in: nested.has(z.id), dash: z.dash }]}
            x={z.x}
            y={z.y}
            width={z.w}
            height={z.h}
            rx="8"
          />
          {!z.center && (
            <text class="zl" x={z.x + 12} y={z.y + 20}>
              {z.label[lang]}
            </text>
          )}
          {z.note && (
            <text
              class:list={['zn', { acc: z.note.accent }]}
              x={z.x + z.w - 12}
              y={z.y + 20}
              text-anchor="end"
            >
              {z.note.text[lang]}
            </text>
          )}
        </>
      ))}
      {/* Distance rings with their labels on masks, the center point, and captions sit under the connectors. */}
      {rings?.items.map((r) => {
        const w = est(r.label[lang]) + 12;
        return (
          <>
            <circle class:list={['ring', { acc: r.accent }]} cx={rings.x} cy={rings.y} r={r.r} />
            <rect
              class="em wash"
              x={rings.x - w / 2}
              y={rings.y - r.r - 8}
              width={w}
              height="16"
              rx="2"
            />
            <text
              class:list={['rt', { acc: r.accent }]}
              x={rings.x}
              y={rings.y - r.r + 4}
              text-anchor="middle"
            >
              {r.label[lang]}
            </text>
          </>
        );
      })}
      {rings && (
        <>
          <circle class="rc" cx={rings.x} cy={rings.y} r="9" />
          <text class="ns" x={rings.x} y={rings.y + 26} text-anchor="middle">
            {rings.center[lang]}
          </text>
        </>
      )}
      {texts.map((x) => (
        <text class="ns" x={x.x} y={x.y} text-anchor={x.anchor}>
          {x.text[lang]}
        </text>
      ))}
      {route && <path class="route" d={route} />}
      {edges.map((e) => (
        <path
          class:list={['ln', { back: e.style === 'back', acc: e.style === 'acc' }]}
          d={e.d}
          marker-end={e.style === 'acc' ? arrowAcc : arrow}
          marker-start={e.style === 'both' ? arrow : undefined}
        />
      ))}
      {curve && <path class="cv" d={curve} />}
      {zones
        .filter((z) => z.center)
        .map((z) => {
          const w = est(z.label[lang]) + 12;
          return (
            <>
              <rect
                class:list={['zm', { in: nested.has(z.id) }]}
                x={z.x + z.w / 2 - w / 2}
                y={z.y + 8}
                width={w}
                height="16"
                rx="2"
              />
              <text class="zl" x={z.x + z.w / 2} y={z.y + 20} text-anchor="middle">
                {z.label[lang]}
              </text>
            </>
          );
        })}
      {edges
        .filter((e) => e.label)
        .map(({ label: l, style }) => {
          const w = lw(l!.text[lang]) + 8;
          const x = l!.anchor === 'start' ? l!.x - 4 : l!.x - w / 2;
          return (
            <>
              <rect
                class:list={['em', { wash: onWash(l!) }]}
                x={x}
                y={l!.y - 8}
                width={w}
                height="11"
                rx="2"
              />
              <text
                class:list={['el', { acc: style === 'acc' }]}
                x={l!.x}
                y={l!.y}
                text-anchor={l!.anchor}
              >
                {l!.text[lang]}
              </text>
            </>
          );
        })}
      {callouts.map((c) => (
        <>
          <path class="ptr" d={`M${c.px},${c.py > c.y ? c.y + c.h : c.y} V${c.py}`} />
          <rect class="co" x={c.x} y={c.y} width={c.w} height={c.h} rx="6" />
          {lines(c.text[lang]).map((s, i) => (
            <text class="cot" x={c.x + 20} y={c.y + 16 + i * 14}>
              {s}
            </text>
          ))}
          <circle class="mkc" cx={c.x + 2} cy={c.y + 2} r="8" />
          <text class="mkt" x={c.x + 2} y={c.y + 5} text-anchor="middle">
            {c.n}
          </text>
        </>
      ))}
      {nodes.map((n) => {
        const ls = lines(n.label[lang]);
        const rows = ls.length + (n.sub ? 1 : 0);
        // First baseline so the block of rows (14px apart) is centered in the box.
        const y0 = n.y + n.h / 2 - ((rows - 1) * 14) / 2 + 4;
        const cx = n.x + n.w / 2;
        return (
          <g class={`k-${n.kind}`}>
            {n.kind === 'decision' ? (
              <polygon
                points={`${cx},${n.y} ${n.x + n.w},${n.y + n.h / 2} ${cx},${n.y + n.h} ${n.x},${n.y + n.h / 2}`}
              />
            ) : (
              <rect x={n.x} y={n.y} width={n.w} height={n.h} rx="6" />
            )}
            {ls.map((s, i) => (
              <text class="nt" x={cx} y={y0 + i * 14} text-anchor="middle">
                {s}
              </text>
            ))}
            {n.sub && (
              <text class="ns" x={cx} y={y0 + ls.length * 14} text-anchor="middle">
                {n.sub[lang]}
              </text>
            )}
          </g>
        );
      })}
      {/* Marks: a circle for one digit, a pill for "1 · 2"; the name and sublabel sit at (lx, ly). */}
      {marks.map((m) => {
        const w = m.n.length > 1 ? Math.max(24, m.n.length * 6 + 16) : 24;
        return (
          <>
            <rect class="mkc" x={m.x - w / 2} y={m.y - 12} width={w} height="24" rx="12" />
            <text class="mkt" x={m.x} y={m.y + 4} text-anchor="middle">
              {m.n}
            </text>
            {m.label && (
              <text class="nt" x={m.lx ?? m.x} y={m.ly ?? m.y - 20} text-anchor={m.anchor}>
                {m.label[lang]}
              </text>
            )}
            {m.sub && (
              <text class="ns" x={m.lx ?? m.x} y={(m.ly ?? m.y - 20) + 14} text-anchor={m.anchor}>
                {m.sub[lang]}
              </text>
            )}
          </>
        );
      })}
      {/* Dots: label above for outside touchpoints, below for the client's own (multi-line labels grow away from the dot). */}
      {dots.map((d) => {
        const ls = lines(d.label[lang]);
        return (
          <>
            <circle class={`dot ${d.lane}`} cx={d.x} cy={d.y} r="5" />
            {ls.map((s, i) => (
              <text
                class="nt"
                x={d.x}
                y={d.lane === 'out' ? d.y - 14 - (ls.length - 1 - i) * 14 : d.y + 22 + i * 14}
                text-anchor="middle"
              >
                {s}
              </text>
            ))}
          </>
        );
      })}
      <line class="rule" x1="0" y1={LG - 20} x2={W} y2={LG - 20}></line>
      {legend.map((l, i) => (
        <>
          {l.kind === 'acc-line' ? (
            <path class="ln acc" d={`M${i * lgStep},${LG - 4} H${i * lgStep + 16}`} />
          ) : l.kind === 'mark' ? (
            <circle class="mkc" cx={i * lgStep + 8} cy={LG - 4} r="6" />
          ) : l.kind.startsWith('dot-') ? (
            <circle class={`dot ${l.kind.slice(4)}`} cx={i * lgStep + 8} cy={LG - 4} r="5" />
          ) : (
            <g class={`k-${l.kind}`}>
              <rect x={i * lgStep} y={LG - 10} width="16" height="12" rx="3" />
            </g>
          )}
          <text class="lg" x={i * lgStep + 24} y={LG}>
            {l.label[lang]}
          </text>
        </>
      ))}
    </svg>
  </div>
  <p class="hint">{t(lang, 'dgScroll')}</p>
  <div class="sr-only">
    <p>{t(lang, 'dgParts')}</p>
    <ul>
      {[...groups]
        .filter(([, items]) => items.length)
        .map(([id, items]) => (
          <li>
            {id ? `${zoneLabel.get(id)}: ` : ''}
            {items.join('; ')}
          </li>
        ))}
    </ul>
    {edges.length > 0 && (
      <>
        <p>{t(lang, 'dgLinks')}</p>
        <ul>
          {edges.map((e) => (
            <li>{linkText(e)}</li>
          ))}
        </ul>
      </>
    )}
    {pathText && <p>{t(lang, 'dgPath', { a: pathText })}</p>}
    {stopText && <p>{t(lang, 'dgPath', { a: stopText })}</p>}
    {rings && (
      <p>
        {t(lang, 'dgRings', {
          a: rings.center[lang],
          b: rings.items.map((r) => r.label[lang]).join('; '),
        })}
      </p>
    )}
    {texts.map((x) => (
      <p>{x.text[lang]}</p>
    ))}
    {callouts.length > 0 && (
      <>
        <p>{t(lang, 'dgPains')}</p>
        <ol>
          {callouts.map((c) => (
            <li>
              {c.text[lang].replace(/\n/g, ' ')} ({name.get(c.on)})
            </li>
          ))}
        </ol>
      </>
    )}
  </div>
</figure>

<style>
  .dg {
    container-type: inline-size;
    position: relative;
  }

  /* Narrower than the drawing (≤640px column: tablet sidebar widths and phones): scroll inside the figure. */
  .dg-scroll {
    overflow-x: auto;
  }

  .dg-scroll:focus-visible {
    outline: var(--focus-w) solid var(--focus);
    outline-offset: var(--focus-offset);
    border-radius: var(--radius-xs);
  }

  svg {
    display: block;
    width: 100%;
    min-width: 640px;
    height: auto;
    font-family: inherit;
  }

  .hint {
    display: none;
    margin-top: var(--sp-2);
    font-size: var(--fs-xs);
    color: var(--text-3);
  }

  @container (max-width: 639px) {
    .hint {
      display: block;
    }
  }

  /* Node kinds: sLLM is the one accent; LLM a strong outline; logic a quiet fill; input dashed. */
  .k-sllm rect {
    fill: var(--accent-soft);
    stroke: var(--accent);
    stroke-width: 1;
  }

  .k-llm rect {
    fill: var(--surface);
    stroke: var(--text-2);
    stroke-width: 1.2;
  }

  .k-logic rect {
    fill: var(--chip);
    stroke: var(--line-strong);
    stroke-width: 0.8;
  }

  .k-plain rect {
    fill: var(--surface);
    stroke: var(--line-strong);
    stroke-width: 1;
  }

  .k-input rect {
    fill: var(--surface);
    stroke: var(--line-strong);
    stroke-dasharray: 4 3;
  }

  /* Without an sLLM the accent goes to one focal kind (focus), or outlines what a version added (new). */
  .k-focus rect {
    fill: var(--accent-soft);
    stroke: var(--accent);
    stroke-width: 1;
  }

  .k-new rect {
    fill: var(--surface);
    stroke: var(--accent);
    stroke-width: 1.2;
  }

  /* Non-LLM automated steps share the LLM outline; a yes/no check is a diamond with the same stroke. */
  .k-step rect,
  .k-decision polygon {
    fill: var(--surface);
    stroke: var(--text-2);
    stroke-width: 1.2;
  }

  /* A layer the path skips, or a system left unconnected: faint dotted outline, muted name. */
  .k-ghost rect {
    fill: none;
    stroke: var(--line-strong);
    stroke-dasharray: 2 3;
  }

  .k-ghost .nt {
    fill: var(--text-3);
  }

  /* Sizes follow diagram-design: name 12px semibold, sublabel 9px mono, edge label 8px mono. */
  .nt {
    fill: var(--text);
    font-size: 12px;
    font-weight: var(--fw-strong);
  }

  .ns,
  .el {
    fill: var(--text-3);
    font-family: var(--font-meta);
  }

  .ns {
    font-size: 9px;
  }

  .el {
    font-size: 8px;
    letter-spacing: 0.06em;
  }

  .zone {
    fill: var(--bg);
  }

  .zl {
    fill: var(--text-2);
    font-size: 12px;
    font-weight: var(--fw-strong);
  }

  .zm {
    fill: var(--bg);
  }

  .zone.in,
  .zm.in {
    fill: var(--surface);
  }

  .zone.in {
    stroke: var(--line-strong);
    stroke-width: 0.8;
  }

  .em {
    fill: var(--surface);
  }

  .em.wash {
    fill: var(--bg);
  }

  .ln {
    fill: none;
    stroke: var(--text-3);
    stroke-width: 1.2;
  }

  .ln.back {
    stroke-dasharray: 4 3;
  }

  .mk {
    fill: var(--text-3);
  }

  .rule {
    stroke: var(--line);
  }

  .lg {
    fill: var(--text-2);
    font-size: 12px;
  }

  .zn {
    fill: var(--text-2);
    font-size: 12px;
    font-family: var(--font-meta);
  }

  .zn.acc {
    fill: var(--accent);
    font-weight: var(--fw-strong);
  }

  /* Customer journey: stage chevrons, path through touchpoint dots, numbered pain points with quotes. */
  .stg {
    fill: var(--chip);
  }

  .stt {
    fill: var(--text-2);
    font-size: 12px;
    font-weight: var(--fw-medium);
  }

  .cv {
    fill: none;
    stroke: var(--text-2);
    stroke-width: 1.4;
  }

  .dot.own {
    fill: var(--text);
  }

  .dot.out {
    fill: var(--surface);
    stroke: var(--text-2);
    stroke-width: 1.4;
  }

  .co {
    fill: var(--surface);
    stroke: var(--line-strong);
  }

  .cot {
    fill: var(--text-2);
    font-size: 12px;
  }

  .ptr {
    stroke: var(--line-strong);
    stroke-dasharray: 2 2;
  }

  .mkc {
    fill: var(--accent);
  }

  .mkt {
    fill: var(--surface);
    font-size: 9px;
    font-weight: var(--fw-strong);
    font-family: var(--font-meta);
  }

  /* Floor plan and safety (docent, 11.13): dashed plan area, accent safety path, walking stretch, distance rings. */
  .zone.dash {
    fill: none;
    stroke: var(--line-strong);
    stroke-dasharray: 4 3;
  }

  .ln.acc {
    stroke: var(--accent);
    stroke-width: 1.6;
  }

  .mk.acc,
  .el.acc {
    fill: var(--accent);
  }

  .route {
    fill: none;
    stroke: var(--text-2);
    stroke-width: 4;
    stroke-linecap: round;
  }

  .ring {
    fill: none;
    stroke: var(--text-3);
    stroke-width: 1.2;
    stroke-dasharray: 4 3;
  }

  .ring.acc {
    fill: var(--accent-soft);
    stroke: var(--accent);
    stroke-dasharray: none;
  }

  .rt {
    fill: var(--text-2);
    font-size: 12px;
    font-weight: var(--fw-strong);
  }

  .rt.acc {
    fill: var(--accent);
  }

  .rc {
    fill: var(--text);
  }
</style>
