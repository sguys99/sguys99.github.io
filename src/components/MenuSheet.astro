---
// Mobile menu sheet (DESIGN.md 5.3, 9장 메뉴 시트). Native modal <dialog>: inert background, focus inside, Esc closes.
import { getEntry } from 'astro:content';
import Icon from './Icon.astro';
import LangSwitch from './LangSwitch.astro';
import ThemeToggle from './ThemeToggle.astro';
import { t, TABS, type Lang } from '../i18n/ui';
import { CV_PDF } from '../cv-pdf.mjs';

interface Props {
  lang: Lang;
  /** Case study (5.2 케이스 변형): "← Selected Work" + its sections instead of the home tabs. */
  links?: { href: string; label: string; back?: boolean }[];
}

const { lang, links } = Astro.props;
const { email, github, linkedin } = (await getEntry('profile', 'profile'))!.data.contact;
---

<dialog class="sheet" id="sheet" aria-labelledby="sheet-title">
  <div class="sheet-in">
    <div class="sheet-head">
      <h2 id="sheet-title">{t(lang, 'menu')}</h2>
      <button type="button" class="icon-btn" data-sheet-close aria-label={t(lang, 'closeMenu')}>
        <Icon name="close" />
      </button>
    </div>
    <nav aria-label={t(lang, 'sections')}>
      {/* aria-current is set by the scroll-spy in Topbar.astro. */}
      <ul class="sheet-nav" data-nav>
        {links?.map((l) => (
          <li>
            <a href={l.href}>
              {l.back ? (
                <span class="back">
                  <Icon name="back" size="sm" />
                  {l.label}
                </span>
              ) : (
                l.label
              )}
            </a>
          </li>
        ))}
        {!links &&
          TABS.map((tab) => (
            <li>
              <a href={`#${tab.id}`} data-for={tab.covers.join(' ')}>
                {t(lang, `tab_${tab.id}`)}
              </a>
              {tab.covers.length > 1 && (
                <ul class="sheet-sub">
                  {tab.covers.map((id) => (
                    <li>
                      <a href={`#${id}`}>{t(lang, id)}</a>
                    </li>
                  ))}
                </ul>
              )}
            </li>
          ))}
      </ul>
    </nav>
    <ul class="contact">
      <li>
        <a href={`mailto:${email}`}>
          <Icon name="mail" />
          <span class="lbl">{email}</span>
        </a>
      </li>
      <li>
        <a href={github} rel="noopener">
          <Icon name="gh" />
          <span class="lbl">GitHub</span>
        </a>
      </li>
      <li>
        <a href={linkedin} rel="noopener">
          <Icon name="in" />
          <span class="lbl">LinkedIn</span>
        </a>
      </li>
      {/* Mobile home for the sidebar's CV row, which ≤860 hides (11.8). */}
      <li>
        <a href={CV_PDF[lang]} download>
          <Icon name="download" />
          <span class="lbl">{t(lang, 'cv')}</span>
        </a>
      </li>
    </ul>
    <div class="sheet-prefs">
      <div>
        <span class="sheet-label">{t(lang, 'language')}</span>
        <LangSwitch lang={lang} />
      </div>
      <div>
        <span class="sheet-label">{t(lang, 'theme')}</span>
        <ThemeToggle lang={lang} />
      </div>
    </div>
  </div>
</dialog>

<script>
  const sheet = document.getElementById('sheet') as HTMLDialogElement;
  const menuBtn = document.querySelector<HTMLButtonElement>('.menu-btn')!;

  menuBtn.addEventListener('click', () => {
    sheet.showModal();
    menuBtn.setAttribute('aria-expanded', 'true');
  });
  sheet.addEventListener('close', () => {
    menuBtn.setAttribute('aria-expanded', 'false');
    // <dialog> restores focus itself; this covers browsers that do not.
    // preventScroll: focusing a button in the sticky bar scrolls the page back to the bar's static spot (Chromium).
    menuBtn.focus({ preventScroll: true });
  });
  sheet.addEventListener('click', (e) => {
    const el = e.target as Element;
    // target is the dialog itself only on the backdrop, since .sheet-in fills the box.
    if (el === sheet || el.closest('[data-sheet-close]')) sheet.close();
    // Section links: close after the anchor jump starts; closing first cancels the scroll (Chromium).
    else if (el.closest('.sheet-nav a')) setTimeout(() => sheet.close());
  });
  // The sheet only exists on mobile; close it if the window widens past the breakpoint.
  matchMedia('(min-width: 861px)').addEventListener('change', (e) => {
    if (e.matches) sheet.close();
  });
</script>

<style>
  .sheet {
    margin: 0 0 0 auto;
    padding: 0;
    border: 0;
    border-left: 1px solid var(--line);
    width: min(var(--sheet-w), 88vw);
    max-width: none;
    height: 100vh;
    height: 100dvh;
    max-height: none;
    background: var(--surface);
    color: var(--text);
  }

  .sheet::backdrop {
    background: var(--scrim);
  }

  @media (prefers-reduced-motion: no-preference) {
    .sheet[open] {
      animation: sheet-in var(--m-sheet) var(--ease-out);
    }

    .sheet[open]::backdrop {
      animation: fade-in var(--m-sheet) var(--ease-out);
    }
  }

  @keyframes sheet-in {
    from {
      transform: translateX(100%);
    }
  }

  @keyframes fade-in {
    from {
      opacity: 0;
    }
  }

  @media (min-width: 861px) {
    .sheet {
      display: none;
    }
  }

  .sheet-in {
    min-height: 100%;
    display: flex;
    flex-direction: column;
    gap: var(--sp-6);
    padding: var(--sp-3) var(--sp-5) var(--sp-6);
  }

  .sheet-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: var(--header-h);
  }

  .sheet-head h2,
  .sheet-label {
    font-size: var(--fs-xs);
    font-weight: var(--fw-strong);
    letter-spacing: var(--ls-label);
    text-transform: uppercase;
    color: var(--text-3);
  }

  html:lang(ko) .sheet-head h2,
  html:lang(ko) .sheet-label {
    font-size: var(--fs-sm);
    letter-spacing: var(--ls-label-ko);
    text-transform: none;
  }

  .sheet-nav,
  .sheet-sub,
  .contact {
    list-style: none;
  }

  .sheet-nav {
    border-top: 1px solid var(--line);
  }

  .sheet-nav > li {
    border-bottom: 1px solid var(--line);
  }

  .sheet-nav a {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--sp-3);
    text-decoration: none;
  }

  .sheet-nav > li > a {
    padding: var(--sp-3) 0;
    font-size: var(--fs-lg);
    font-weight: var(--fw-medium);
    color: var(--text-2);
  }

  /* Current-section dot; filled by aria-current. Sub-contents links share it, so the current item is not
     marked by colour alone (9장, 11.8). */
  .sheet-nav a::after {
    content: '';
    width: var(--dot);
    height: var(--dot);
    border-radius: var(--radius-pill);
    background: transparent;
  }

  .sheet-nav > li > a[aria-current='true'] {
    color: var(--text);
  }

  .sheet-nav a[aria-current='true']::after {
    background: var(--accent);
  }

  .sheet-nav > li:has(.sheet-sub) > a[aria-current='true']::after {
    background: transparent;
  }

  .back {
    display: inline-flex;
    align-items: center;
    gap: var(--sp-1h);
  }

  .sheet-sub {
    margin-top: calc(-1 * var(--sp-2));
    padding: 0 0 var(--sp-3) var(--sp-4);
    border-left: 1px solid var(--line);
  }

  .sheet-sub a {
    padding: var(--sp-1) 0;
    font-size: var(--fs-sm);
    font-weight: var(--fw-regular);
    letter-spacing: 0;
    color: var(--text-3);
  }

  .sheet-sub a[aria-current='true'] {
    color: var(--accent);
  }

  .contact {
    display: grid;
    gap: var(--sp-3);
  }

  .contact a {
    display: flex;
    align-items: center;
    gap: var(--sp-2);
    font-size: var(--fs-sm);
    color: var(--text-2);
    text-decoration: none;
    transition: color var(--dur) ease;
  }

  .contact a:hover {
    color: var(--accent);
  }

  .lbl {
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .sheet-prefs {
    margin-top: auto;
    display: grid;
    gap: var(--sp-3);
    padding-top: var(--sp-4);
    border-top: 1px solid var(--line);
  }

  .sheet-prefs > div {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--sp-3);
    min-height: var(--ctl-h-lg);
  }

  /* Keep the page still behind the open sheet. */
  :global(html:has(.sheet[open])) {
    overflow: hidden;
  }
</style>
