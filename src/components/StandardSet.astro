---
// Standard delivery set under the Architecture diagram (DESIGN.md 5.24.12; g14 시안 C + A의 사양 띠):
// robot photo, local server and external services with the links between them (SVG), what runs on each (lists),
// then the robot's specifications. Data: caseStudy.hardware.
import type { CollectionEntry } from 'astro:content';
import { getImage } from 'astro:assets';
import { t, type Lang } from '../i18n/ui';

type Hardware = NonNullable<
  NonNullable<CollectionEntry<'projects'>['data']['caseStudy']>['hardware']
>;

interface Props {
  lang: Lang;
  data: Hardware;
  label: string; // accessible name, the heading above the figure
}

const { lang, data, label } = Astro.props;
const { image, alt, robot, server, external, links, specsTitle, specs, credit } = data;
const photo = await getImage({ src: image, width: 400, format: 'webp' });
const units = [robot, server, external];
const id = `ss-${lang}`;
// SVG units: photo 0–216, server drawing SX–SX+152, external box 556–712, links on y 108.
const SX = 296;
---

<figure class="ss">
  <div class="ss-scroll" tabindex="0" role="region" aria-label={label}>
    <svg viewBox="0 0 720 216" aria-hidden="true" focusable="false">
      <defs>
        <marker
          id={id}
          markerWidth="8"
          markerHeight="6"
          refX="7"
          refY="3"
          orient="auto-start-reverse"
        >
          <polygon class="mk" points="0 0, 8 3, 0 6"></polygon>
        </marker>
      </defs>
      <rect class="ph" x="0" y="0" width="216" height="216" rx="6" />
      <image
        href={photo.src}
        x="8"
        y="8"
        width="200"
        height="200"
        preserveAspectRatio="xMidYMid meet"
      />
      <path
        class="ln"
        d={`M216,108 H${SX}`}
        marker-start={`url(#${id})`}
        marker-end={`url(#${id})`}
      />
      <text class="el" x={(216 + SX) / 2} y="98" text-anchor="middle">
        {links.robotServer[0]}
      </text>
      <text class="el" x={(216 + SX) / 2} y="126" text-anchor="middle">
        {links.robotServer[1]}
      </text>
      <rect class="box" x={SX} y="48" width="152" height="120" rx="6" />
      {[0, 1, 2, 3].map((i) => (
        <>
          <rect class="slot" x={SX + 12} y={60 + i * 26} width="128" height="18" rx="2" />
          <circle class="led" cx={SX + 128} cy={69 + i * 26} r="2.5" />
        </>
      ))}
      <path
        class="ln dash"
        d={`M${SX + 152},108 H556`}
        marker-start={`url(#${id})`}
        marker-end={`url(#${id})`}
      />
      <text class="el" x={(SX + 152 + 556) / 2} y="98" text-anchor="middle">
        {links.serverExternal[lang]}
      </text>
      <rect class="ext" x="556" y="64" width="156" height="88" rx="6" />
      <text class="nt" x="634" y="104" text-anchor="middle">
        LLM · STT · TTS
      </text>
    </svg>
  </div>
  <p class="hint">{t(lang, 'dgScroll')}</p>
  <p class="sr-only">
    {alt[lang]}. {robot.name[lang]} — {links.robotServer.join(', ')} — {server.name[lang]} —{' '}
    {links.serverExternal[lang]} — {external.name[lang]}
  </p>
  <div class="units">
    {units.map((u) => (
      <section>
        <h4>{u.name[lang]}</h4>
        <p class="sub">{u.sub[lang]}</p>
        <dl>
          {u.items.map((it) => (
            <div>
              <dt>{it.name[lang]}</dt>
              <dd>{it.value[lang]}</dd>
            </div>
          ))}
        </dl>
      </section>
    ))}
  </div>
  <h4 class="sp-t">{specsTitle[lang]}</h4>
  <dl class="specs">
    {specs.map((s) => (
      <div>
        <dt>{s.label[lang]}</dt>
        <dd>{s.value[lang]}</dd>
      </div>
    ))}
  </dl>
  <p class="credit">{credit[lang]}</p>
</figure>

<style>
  .ss {
    container-type: inline-size;
  }

  /* Same narrow-column rule as the diagrams (5.24.4): keep 12px text, scroll inside the figure. */
  .ss-scroll {
    overflow-x: auto;
  }

  .ss-scroll:focus-visible {
    outline: var(--focus-w) solid var(--focus);
    outline-offset: var(--focus-offset);
    border-radius: var(--radius-xs);
  }

  svg {
    display: block;
    width: 100%;
    min-width: 640px;
    height: auto;
    font-family: inherit;
  }

  .hint {
    display: none;
    margin-top: var(--sp-2);
    font-size: var(--fs-xs);
    color: var(--text-3);
  }

  @container (max-width: 639px) {
    .hint {
      display: block;
    }
  }

  /* Product shot on a white ground with a hairline frame, as in the robot comparison (5.24.7). */
  .ph {
    fill: #fff;
    stroke: var(--line);
  }

  .box {
    fill: var(--surface);
    stroke: var(--line-strong);
  }

  .slot {
    fill: var(--bg);
  }

  .led {
    fill: var(--text-2);
  }

  .ext {
    fill: var(--surface);
    stroke: var(--line-strong);
    stroke-dasharray: 4 3;
  }

  .ln {
    fill: none;
    stroke: var(--text-3);
    stroke-width: 1.2;
  }

  .ln.dash {
    stroke-dasharray: 4 3;
  }

  .mk {
    fill: var(--text-3);
  }

  .nt {
    fill: var(--text);
    font-size: 12px;
    font-weight: var(--fw-strong);
  }

  .el {
    fill: var(--text-3);
    font-family: var(--font-meta);
    font-size: 8px;
    letter-spacing: 0.06em;
  }

  /* What runs where: three columns under the drawing, stacked when narrow. */
  .units {
    display: grid;
    grid-template-columns: 30% 34% 24%;
    justify-content: space-between;
    margin-top: var(--sp-4);
  }

  h4 {
    font-size: var(--fs-sm);
    font-weight: var(--fw-strong);
    color: var(--text);
  }

  .sub {
    margin-top: var(--sp-0);
    font-family: var(--font-meta);
    font-size: var(--fs-xs);
    color: var(--text-3);
  }

  .units dl {
    margin-top: var(--sp-2);
  }

  .units dl > div {
    display: flex;
    justify-content: space-between;
    gap: var(--sp-2);
    padding: var(--sp-1) 0;
    border-top: 1px solid var(--line);
    font-size: var(--fs-sm);
  }

  .units dt {
    color: var(--text-2);
  }

  .units dd {
    font-family: var(--font-meta);
    font-size: var(--fs-xs);
    color: var(--text-3);
    text-align: right;
  }

  /* Robot specifications: small uppercase labels over values, three to a row (g14 시안 A의 사양 띠). */
  .sp-t {
    margin-top: var(--sp-5);
  }

  .specs {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--sp-3) var(--sp-4);
    margin-top: var(--sp-2);
    padding-top: var(--sp-3);
    border-top: 1px solid var(--line-strong);
  }

  .specs dt {
    font-size: var(--fs-2xs);
    letter-spacing: var(--ls-eyebrow);
    text-transform: uppercase;
    color: var(--text-3);
  }

  html:lang(ko) .specs dt {
    font-size: var(--fs-xs);
    letter-spacing: 0;
    text-transform: none;
  }

  .specs dd {
    margin-top: var(--sp-0);
    font-size: var(--fs-sm);
    color: var(--text-2);
  }

  .credit {
    margin-top: var(--sp-3);
    font-size: var(--fs-xs);
    color: var(--text-3);
  }

  @container (max-width: 560px) {
    .units {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--sp-4);
    }

    .specs {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
