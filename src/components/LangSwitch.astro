---
// Language segment (DESIGN.md 5.4): links, current language marked with aria-current.
// Targets the same page in each language (6.1); the scroll-spy adds the current section to data-lang-alt links.
import { t, langPath, LANG_CODE, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
---

<div class="seg" role="group" aria-label={t(lang, 'language')}>
  {(['en', 'ko'] as const).map((l) => (
    <a
      href={langPath(Astro.url.pathname, l)}
      lang={l}
      hreflang={l}
      aria-current={l === lang ? 'true' : undefined}
      data-lang-alt={l === lang ? undefined : ''}
    >
      {LANG_CODE[l]}
    </a>
  ))}
</div>
