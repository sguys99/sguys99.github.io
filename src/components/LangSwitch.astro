---
// Language segment (DESIGN.md 5.4): links, current language marked with aria-current.
// shortcut: both link to the language home; tasks 5.6 points them at the same page in the other language.
import { t, homePath, LANG_CODE, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
---

<div class="seg" role="group" aria-label={t(lang, 'language')}>
  {(['en', 'ko'] as const).map((l) => (
    <a href={homePath(l)} lang={l} hreflang={l} aria-current={l === lang ? 'true' : undefined}>
      {LANG_CODE[l]}
    </a>
  ))}
</div>
