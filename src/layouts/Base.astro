---
// Document shell shared by every page: <html lang>, token + global styles.
// Hooks for later tasks: head meta (5.8) via the "head" slot.
import '../styles/tokens.css';
import '../styles/fonts.css';
import '../styles/global.css';

interface Props {
  lang: 'en' | 'ko';
  title: string;
}

const { lang, title } = Astro.props;
// GoatCounter site code (cookie-free visit count, tasks 8.3). Set e.g. 'sguys99' to enable; '' emits nothing.
const GOATCOUNTER = 'sguys99';
---

<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    {/* Stored theme before any style or paint (DESIGN.md 8장). Inline: an external file would flash. */}
    <script is:inline>
      try {
        const t = localStorage.getItem('theme');
        if (t === 'light' || t === 'dark') document.documentElement.dataset.theme = t;
      } catch {}
      // Cross-fade only when the language changes (global.css @view-transition, DESIGN.md 5.4).
      // No Navigation API → no source URL → no fade (instant, like unsupported browsers).
      addEventListener('pagereveal', (e) => {
        const vt = e.viewTransition;
        if (!vt) return;
        const from = self.navigation?.activation?.from?.url;
        const ko = (p) => /^\/ko(\/|$)/.test(p);
        if (!from || ko(new URL(from).pathname) === ko(location.pathname)) vt.skipTransition();
      });
    </script>
    <meta name="viewport" content="width=device-width" />
    <title>{title}</title>
    {
      /* Only the English page knows its font up front; Korean needs whichever subsets the text hits (DESIGN.md 7장). */
      lang === 'en' && (
        <link
          rel="preload"
          href="/fonts/geist/Geist-Latin-wght.woff2"
          as="font"
          type="font/woff2"
          crossorigin
        />
      )
    }
    <link rel="stylesheet" href="/fonts/pretendard/pretendardvariable-dynamic-subset.css" />
    <slot name="head" />
    {
      GOATCOUNTER && (
        <script
          is:inline
          data-goatcounter={`https://${GOATCOUNTER}.goatcounter.com/count`}
          async
          src="https://gc.zgo.at/count.js"
        />
      )
    }
  </head>
  <body>
    <slot />
  </body>
</html>
