---
// Page frame for home and case study: Base document + site Shell (DESIGN.md 4장).
import Base from './Base.astro';
import Shell from './Shell.astro';
import type { Lang, SectionId } from '../i18n/ui';

interface Props {
  lang: Lang;
  title: string;
  current?: SectionId;
  curLabel?: string;
  sheet?: { href: string; label: string; back?: boolean }[];
}

const { title, ...shell } = Astro.props;
---

<Base lang={shell.lang} title={title}>
  <slot name="head" slot="head" />
  <Shell {...shell}>
    <slot name="sidebar" slot="sidebar" />
    <slot />
  </Shell>
</Base>
