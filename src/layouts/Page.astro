---
// Page frame shared by home, case study and 404 (DESIGN.md 4장): skip link, top bar, sidebar, main, mobile menu sheet.
// DOM order is navigation first (9장 키보드 순서); grid placement keeps the sidebar visually on the left.
import Base from './Base.astro';
import Sidebar from '../components/Sidebar.astro';
import Topbar from '../components/Topbar.astro';
import MenuSheet from '../components/MenuSheet.astro';
import { t, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
  title: string;
}

const { lang, title } = Astro.props;
---

<Base lang={lang} title={title}>
  <slot name="head" slot="head" />
  <a class="skip" href="#main">
    {t(lang, 'skip')}
  </a>
  <div class="shell">
    <Topbar lang={lang} />
    <Sidebar lang={lang} />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    {/* Footer: tasks 5.9 (right column, row after main) */}
  </div>
  <MenuSheet lang={lang} />
</Base>

<style>
  /* Hidden like .sr-only until focused, then shown top-left above the top bar (DESIGN.md 9장). */
  .skip {
    position: absolute;
    top: var(--sp-2);
    left: var(--sp-2);
    z-index: var(--z-skip);
    padding: var(--sp-2) var(--sp-3);
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius-xs);
    font-size: var(--fs-sm);
  }

  .skip:not(:focus-visible) {
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
    border: 0;
  }

  .shell {
    display: grid;
    grid-template-columns: var(--sidebar) minmax(0, 1fr);
    /* Row 1 reserves the bar (+1px bottom line); the bar itself spans every row so it can stay sticky. */
    grid-template-rows: calc(var(--header-h) + 1px) 1fr;
    min-height: 100vh;
    min-height: 100dvh;
    max-width: calc(var(--sidebar) + var(--main));
    margin: 0 auto;
  }

  .shell > :global(.topbar) {
    grid-column: 2;
    grid-row: 1 / -1;
    align-self: start;
    min-width: 0;
  }

  .shell > :global(.sidebar) {
    grid-column: 1;
    grid-row: 1 / -1;
  }

  main {
    grid-column: 2;
    grid-row: 2;
    min-width: 0;
    max-width: var(--main);
    width: 100%;
    padding: var(--sp-6) var(--sp-7);
  }

  main:focus {
    outline: none;
  }

  @media (max-width: 1100px) {
    :global(:root) {
      --sidebar: 280px;
    }

    main {
      padding: var(--sp-6);
    }
  }

  @media (max-width: 860px) {
    :global(:root) {
      --header-h: 52px;
    }

    .shell {
      display: flex;
      flex-direction: column;
    }

    .shell > :global(.topbar) {
      align-self: stretch;
    }

    main {
      padding: var(--sp-4) var(--sp-4) var(--sp-6);
    }
  }
</style>
